# ---------------------------------------------------------------------------
# AireDirect — environment variables (example)
# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# Public base URL of the app (used in email links and Stripe redirect URLs)
APP_BASE_URL=http://localhost:3000
# Port for the standalone Express server (node server/index.js)
PORT=4000

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
LOCK_SECRET=change-me
CSRF_SECRET=change-me
SESSION_COOKIE_NAME=ad_session

# Demo UI flags
DEMO_BANNER=true
DEMO_AUTOFILL=true

# Adapter selection: mock | live  (chosen per integration domain)
PAYMENTS_ADAPTER=mock
FINANCING_ADAPTER=mock
CRM_ADAPTER=mock
EMAIL_ADAPTER=mock
SMS_ADAPTER=mock
ADDRESS_ADAPTER=mock

# --- Live adapter credentials (only needed when the matching adapter = live) ---
# Stripe (payments) — use test keys in staging
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# HubSpot (CRM) — private app access token
HUBSPOT_ACCESS_TOKEN=
# SendGrid (email)
SENDGRID_API_KEY=
SENDGRID_FROM=no-reply@airedirect.example
# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Google Places (address lookup)
GOOGLE_PLACES_API_KEY=

# Internal notification recipient for the sales team
SALES_NOTIFY_EMAIL=sales@airedirect.example
