# ===== Copy to .env for local development. NEVER commit .env. =====

# --- Server
PORT=3000
NODE_ENV=development
# Public base URL (used in emails, Stripe redirect URLs). Must be https in production.
APP_URL=http://localhost:3000
# Set to 1 (or a proxy name) when behind Render/Railway/nginx so rate limiting sees real client IPs.
TRUST_PROXY=
# Production over HTTPS: enables HSTS + upgrade-insecure-requests in the CSP
FORCE_HTTPS=false
# Production over HTTPS: marks cookies Secure
COOKIE_SECURE=false

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# >= 32 chars. Signs session cookies and derives CSRF/webhook-mock secrets.
JWT_SECRET=
# Optional separate secret for price-lock tokens (recommended in production).
LOCK_TOKEN_SECRET=
# true = refuse to boot without the secrets above (use in production)
REQUIRE_SECRETS=false
SESSION_HOURS=8

# --- Demo mode
# true = show the "Demo as..." autofill buttons on /login. MUST be false in production.
DEMO_AUTOFILL=true

# --- Adapter modes: mock | live
PAYMENTS_MODE=mock
FINANCING_MODE=mock
CRM_MODE=mock
NOTIFY_MODE=mock
ADDRESS_MODE=mock
# Mock adapters fail randomly at this rate (0-1) so you can watch the retry queue work
MOCK_FAILURE_RATE=0

# --- Stripe (PAYMENTS_MODE=live) - TEST MODE keys only (sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave unset. Only set true if you deliberately want sk_live_ keys accepted.
STRIPE_ALLOW_LIVE_KEYS=

# --- Financing lender (FINANCING_MODE=live) - generic REST skeleton, adapt to your lender
FINANCING_API_URL=
FINANCING_API_KEY=

# --- HubSpot (CRM_MODE=live) - private app token with crm.objects.contacts/deals write scopes
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE=default
HUBSPOT_STAGE_LOCKED=appointmentscheduled
HUBSPOT_STAGE_PAID=closedwon

# --- SendGrid + Twilio (NOTIFY_MODE=live). Twilio is optional; SMS is skipped if unset.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Internal notification recipient for new locks / paid deposits
SALES_NOTIFY_EMAIL=sales@demo.com

# --- Google Places (ADDRESS_MODE=live) - Places API (New), restrict the key by API + server IP
GOOGLE_PLACES_API_KEY=

# --- Rate limits / queue (defaults shown)
RATE_API_PER_MIN=120
RATE_QUOTE_PER_MIN=40
RATE_LOCK_PER_MIN=10
RATE_LOGIN_PER_15MIN=10
LOGIN_LOCKOUT_AFTER=5
QUEUE_MAX_ATTEMPTS=5
QUEUE_BASE_DELAY_MS=1000
QUEUE_MAX_DELAY_MS=60000
LOG_LEVEL=info
